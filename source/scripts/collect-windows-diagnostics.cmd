@echo off
powershell.exe -NoProfile -Command "& { $ErrorActionPreference='Stop'; $report=Join-Path ([Environment]::GetFolderPath('Desktop')) ('LinkDesk-Diagnostics-'+(Get-Date -Format 'yyyyMMdd-HHmmss')+'.txt'); 'LinkDesk read-only power/display diagnostics' | Out-File -FilePath $report -Encoding UTF8; function Collect([string]$label,[scriptblock]$run) { Add-Content -Path $report -Value ('--- '+$label+' ---') -Encoding UTF8; try { $text=(& $run 2>&1 | Out-String -Width 240); Add-Content -Path $report -Value $text -Encoding UTF8; } catch { Add-Content -Path $report -Value ('Unavailable: '+$_.Exception.Message) -Encoding UTF8; } }; $powercfg=Join-Path $env:SystemRoot 'System32\powercfg.exe'; Collect 'Collection time' { Get-Date -Format o }; Collect 'Windows version and last boot' { Get-CimInstance Win32_OperatingSystem | Select-Object Caption,Version,BuildNumber,LastBootUpTime | Format-List }; Collect 'Display driver information' { Get-CimInstance Win32_VideoController | Select-Object Name,DriverVersion,DriverDate,Status | Format-List }; Collect 'Current LinkDesk process' { Get-Process -Name LinkDesk,deskflow-core -ErrorAction SilentlyContinue | Select-Object ProcessName,Id | Format-Table }; Collect 'Current configured role (not historical)' { $file=Join-Path $env:LOCALAPPDATA 'LinkDesk\preferences.json'; if(Test-Path $file){Get-Content $file -Raw | ConvertFrom-Json | Select-Object Server,AutoConnect,AutoDiscover | Format-List} }; Collect 'Available sleep states' { & $powercfg /a }; Collect 'Last wake reason' { & $powercfg /lastwake }; Collect 'Devices allowed to wake' { & $powercfg /devicequery wake_armed }; Collect 'Current power requests (may require elevation)' { & $powercfg /requests }; Collect 'Active power scheme' { & $powercfg /getactivescheme }; Collect 'Recent power/display events (last 14 days, up to 40)' { Get-WinEvent -FilterHashtable @{LogName='System';StartTime=(Get-Date).AddDays(-14)} -MaxEvents 12000 | Where-Object {$_.ProviderName -match 'Kernel-Power|Power-Troubleshooter|WHEA|^Display$|nvlddmkm|amdkmd|DxgKrnl|^EventLog$'} | Select-Object -First 40 TimeCreated,ProviderName,Id,LevelDisplayName,@{Name='Message';Expression={if($_.Message){$_.Message.Substring(0,[Math]::Min(1800,$_.Message.Length))}}} | Format-List }; Write-Host ('Report: '+$report); }"
echo Diagnostic collection finished. A text report is on your Desktop.
pause
