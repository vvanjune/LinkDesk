@echo off
powershell.exe -NoProfile -Command "& { $ErrorActionPreference='Stop'; $report=Join-Path ([Environment]::GetFolderPath('Desktop')) ('LinkDesk-Diagnostics-'+(Get-Date -Format 'yyyyMMdd-HHmmss')+'.txt'); 'LinkDesk read-only power/display diagnostics' | Out-File -FilePath $report -Encoding UTF8; function Collect([string]$label,[scriptblock]$run) { Add-Content -Path $report -Value ('--- '+$label+' ---') -Encoding UTF8; try { $text=(& $run 2>&1 | Out-String -Width 240); Add-Content -Path $report -Value $text -Encoding UTF8; } catch { Add-Content -Path $report -Value ('Unavailable: '+$_.Exception.Message) -Encoding UTF8; } }; $powercfg=Join-Path $env:SystemRoot 'System32\powercfg.exe'; Collect 'Collection time' { Get-Date -Format o }; Collect 'Windows version and last boot' { Get-CimInstance Win32_OperatingSystem | Select-Object Caption,Version,BuildNumber,LastBootUpTime | Format-List }; Collect 'Display driver information' { Get-CimInstance Win32_VideoController | Select-Object Name,DriverVersion,DriverDate,Status | Format-List }; Collect 'Current LinkDesk process' { Get-Process -Name LinkDesk,deskflow-core -ErrorAction SilentlyContinue | Select-Object ProcessName,Id,StartTime | Format-Table }; Collect 'Current configured role (not historical)' { $file=Join-Path $env:LOCALAPPDATA 'LinkDesk\preferences.json'; if(Test-Path $file){Get-Content $file -Raw | ConvertFrom-Json | Select-Object Server,AutoConnect,AutoStartOnLaunch,LastSessionRequested,WakeDisplayOnRemoteInput,AutoDiscover | Format-List} }; Collect 'Available sleep states' { & $powercfg /a }; Collect 'Last wake reason' { & $powercfg /lastwake }; Collect 'Devices allowed to wake' { & $powercfg /devicequery wake_armed }; Collect 'Current power requests (may require elevation)' { & $powercfg /requests }; Collect 'Active power scheme' { & $powercfg /getactivescheme }; Collect 'Recent power/display events (last 14 days, up to 40)' { Get-WinEvent -FilterHashtable @{LogName='System';StartTime=(Get-Date).AddDays(-14)} -MaxEvents 12000 | Where-Object {$_.ProviderName -match 'Kernel-Power|Power-Troubleshooter|WHEA|^Display$|nvlddmkm|amdkmd|DxgKrnl|^EventLog$'} | Select-Object -First 40 TimeCreated,ProviderName,Id,LevelDisplayName,@{Name='Message';Expression={if($_.Message){$_.Message.Substring(0,[Math]::Min(1800,$_.Message.Length))}}} | Format-List }; Collect 'Application LiveKernelEvent / WER 1001 (last 14 days)' { Get-WinEvent -FilterHashtable @{LogName='Application';Id=1001;StartTime=(Get-Date).AddDays(-14)} -MaxEvents 2000 | Where-Object {$_.Message -match 'LiveKernelEvent|LKD_0x1[Aa]8|LKD_0x1[Bb]8|Blackscreen|BLACK_SCREEN'} | Select-Object -First 60 TimeCreated,ProviderName,Id,@{Name='Message';Expression={if($_.Message){$_.Message.Substring(0,[Math]::Min(4000,$_.Message.Length))}}} | Format-List }; Collect 'Kernel_1a8 / Kernel_1b8 WER archive directories' { $base=Join-Path $env:ProgramData 'Microsoft\Windows\WER\ReportArchive'; $folders=Get-ChildItem $base -Directory -ErrorAction Stop | Where-Object {$_.Name -match '^Kernel_(1a8|1b8)' -and $_.LastWriteTime -ge (Get-Date).AddDays(-14)} | Sort-Object LastWriteTime -Descending | Select-Object -First 60; $folders | Select-Object Name,CreationTime,LastWriteTime | Format-Table -Wrap; foreach($folder in $folders){$wer=Join-Path $folder.FullName 'Report.wer'; if(Test-Path $wer){Get-Content $wer | Where-Object {$_ -match '^(EventType|Sig\[[0-9]+\]\.(Name|Value)|Response\.(BucketId|LegacyBucketId))='}}} }; Collect 'LiveKernelReports file list (no dump contents)' { Get-ChildItem (Join-Path $env:SystemRoot 'LiveKernelReports') -Recurse -File -ErrorAction Stop | Where-Object {$_.LastWriteTime -ge (Get-Date).AddDays(-14)} | Sort-Object LastWriteTime -Descending | Select-Object -First 60 FullName,Length,CreationTime,LastWriteTime | Format-Table -Wrap }; Collect 'LinkDesk start times and packaged display protection' { $apps=Get-Process -Name LinkDesk,deskflow-core -ErrorAction SilentlyContinue; $apps | Select-Object ProcessName,Id,StartTime | Format-Table; foreach($app in $apps){try{$base=Split-Path $app.Path; $manifest=Join-Path $base 'linkdesk-core.json'; if($app.ProcessName -eq 'LinkDesk'){$manifest=Join-Path $base 'core\linkdesk-core.json'};if(Test-Path $manifest){Get-Content $manifest -Raw}}catch{'Core manifest unavailable'}} }; Collect 'Local session/core log locations (contents not uploaded)' { $base=Join-Path $env:LOCALAPPDATA 'LinkDesk'; Get-ChildItem $base -Recurse -Filter 'linkdesk-*.log*' -ErrorAction SilentlyContinue | Select-Object -First 20 FullName,Length,LastWriteTime | Format-Table -Wrap }; Write-Host ('Report: '+$report); }"
echo Diagnostic collection finished. A text report is on your Desktop.
pause
