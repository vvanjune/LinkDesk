<Window x:Class="LinkDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LinkDesk" Icon="Assets/LinkDesk.ico" Width="1060" Height="780" MinWidth="960" MinHeight="700" Background="#F5F5F0" Foreground="#242B3B" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Background" Value="#EAEAF5"/><Setter Property="Foreground" Value="#4C52D4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DEDFE5"/><Setter Property="Background" Value="#FAFAF8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Switch" TargetType="CheckBox"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Width="44" Height="26"><Border x:Name="Track" Background="#D9DBE3" CornerRadius="13"/><Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#4C52D4"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#242B3B"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#FCFCFA" Padding="24"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Top"><TextBlock Text="↗  LinkDesk" FontSize="24" FontWeight="Bold" Foreground="#4C52D4"/><TextBlock Text="一套键鼠，两台电脑" Margin="0,10,0,30" Foreground="#7C8090"/><Button Content="电脑连接" Click="ShowConnection" HorizontalContentAlignment="Left" Margin="0,0,0,10"/><Button Content="配对设备" Click="ShowDevices" Margin="0,0,0,10"/><Button Content="偏好设置" Click="ShowSettings" Margin="0,0,0,10"/><Button Content="键盘与鼠标" Click="ShowInput" Margin="0,0,0,10"/><Button Content="连接日志" Click="ShowLogs"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding AppVersion,StringFormat='LinkDesk · {0}'}" FontSize="11" Foreground="#8A8E9C"/><TextBlock Text="Windows · 原生界面" FontSize="11" Foreground="#A2A5B0" Margin="0,8,0,0"/></StackPanel><Grid/></DockPanel></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32">
   <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="让工作自然流动" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="把注意力留给工作，让键鼠跟随你。" Foreground="#7C8090" Margin="0,10,0,26"/></StackPanel><TextBlock Text="WINDOWS" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0"/></Grid>
   <StackPanel x:Name="ConnectionPage">
    <Border Background="White" CornerRadius="22" Padding="26"><StackPanel>
     <TextBlock Text="{Binding Status}" FontSize="18" FontWeight="Bold" Foreground="#4C52D4"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#7C8090" Margin="0,10,0,24"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#F5F5F0" CornerRadius="16" Padding="22"><StackPanel><TextBlock Text="▱" FontSize="58" HorizontalAlignment="Center"/><TextBlock Text="{Binding LocalName}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="本机 · Windows" FontSize="12" Foreground="#8A8E9C" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
      <TextBlock Grid.Column="1" Text="⇄" Foreground="#4C52D4" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Border Grid.Column="2" Background="#F5F5F0" CornerRadius="16" Padding="22"><StackPanel><TextBlock Text="▰" FontSize="58" HorizontalAlignment="Center"/><TextBlock Text="{Binding CurrentPeerLabel}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="{Binding CurrentPeerSummary}" TextWrapping="Wrap" FontSize="12" Foreground="#8A8E9C" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
     </Grid>
     <Border Height="1" Background="#EDEDF1" Margin="0,24,0,20"/>
     <Grid><StackPanel><TextBlock Text="连接地址" Foreground="#8A8E9C" FontSize="12"/><TextBlock Text="{Binding Address}" FontFamily="Consolas" FontSize="19" Margin="0,8,0,0"/><TextBlock Text="{Binding DiscoveryStatus}" FontSize="11" Foreground="#8A8E9C" Margin="0,7,170,0" TextWrapping="Wrap"/></StackPanel><Button Content="{Binding StartLabel}" Click="ToggleConnection" Background="#4C52D4" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <Border Height="1" Background="#EDEDF1" Margin="0,20,0,14"/>
     <TextBlock Text="本机指纹 · 首次配对时供另一台电脑核对" FontSize="12" Foreground="#8A8E9C"/>
     <TextBox Text="{Binding LocalFingerprint,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="White" Padding="0" Margin="0,8,0,0" AutomationProperties.Name="本机指纹"/>
    </StackPanel></Border>
    <Border Background="#FCFCFA" CornerRadius="18" Padding="24" Margin="0,22,0,0"><StackPanel><TextBlock Text="连接方式" FontWeight="Bold"/><TextBlock Text="两台电脑连到同一路由器、热点或可互通的局域网即可。屏幕位置由共享键鼠的电脑设置。" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#7C8090"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Layout}" IsEnabled="{Binding CanMap}" SelectionChanged="ConnectionOptionChanged" Padding="10,7" Margin="0,16,0,0"><ComboBoxItem Tag="right" Content="另一台电脑在右侧"/><ComboBoxItem Tag="left" Content="另一台电脑在左侧"/><ComboBoxItem Tag="up" Content="另一台电脑在上方"/><ComboBoxItem Tag="down" Content="另一台电脑在下方"/></ComboBox><TextBlock Text="切换方式（防误触）" Foreground="#7C8090" Margin="0,16,0,0"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SwitchDelayChoice}" IsEnabled="{Binding CanMap}" SelectionChanged="ConnectionOptionChanged" Padding="10,7" Margin="0,8,0,0"><ComboBoxItem Tag="0" Content="立即切换（默认）"/><ComboBoxItem Tag="250" Content="指针停留 250 毫秒后切换"/><ComboBoxItem Tag="500" Content="指针停留 500 毫秒后切换"/><ComboBoxItem Tag="1000" Content="指针停留 1 秒后切换"/></ComboBox><TextBlock Text="指针移出屏幕边缘时切换，键盘会跟随。选择“停留”可避免指针擦边时误切换；保存后自动应用。" TextWrapping="Wrap" FontSize="12" Foreground="#8A8E9C" Margin="0,10,0,0"/><Button Content="选择配对设备" Click="ShowDevices" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
   </StackPanel>
   <StackPanel x:Name="DevicesPage" Visibility="Collapsed">
    <Border Background="White" CornerRadius="20" Padding="24"><StackPanel>
     <DockPanel><Button Content="刷新发现" Click="RefreshDevices" DockPanel.Dock="Right"/><TextBlock Text="选择当前连接的电脑" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
     <TextBlock Text="可以配对多台电脑，每次选择一台连接。名称相同也按指纹区分，地址变化不会改变身份。" Foreground="#7C8090" TextWrapping="Wrap" Margin="0,14,0,8"/>
     <TextBlock Text="{Binding DiscoveryStatus}" Foreground="#8A8E9C" FontSize="12" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding CurrentPeerLabel,StringFormat='当前选择：{0}'}" FontWeight="SemiBold" Margin="0,8,0,4"/>
     <TextBlock Text="{Binding CurrentPeerSummary}" Foreground="#8A8E9C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="#F5F5F0" CornerRadius="16" Padding="18" Margin="0,0,0,12"><StackPanel>
       <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="16"/>
       <TextBlock Text="{Binding Summary}" Foreground="#7C8090" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
       <TextBlock Text="{Binding TrustLabel}" Foreground="#4C52D4" FontSize="12" Margin="0,8,0,10"/>
       <Expander Header="完整指纹" Foreground="#7C8090" FontSize="12"><TextBox Text="{Binding FormattedFingerprint,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" BorderThickness="0" Background="#F5F5F0" Margin="0,8,0,8"/></Expander>
       <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding DataContext.CanEdit,RelativeSource={RelativeSource AncestorType=Window}}"><Button Content="{Binding ActionLabel}" Tag="{Binding Id}" Click="ChooseDevice" Background="#4C52D4" Foreground="White" Margin="0,0,10,0"/><Button Content="重命名" Tag="{Binding Id}" Click="RenameDevice" IsEnabled="{Binding Paired}" Margin="0,0,10,0"/><Button Content="更新地址" Tag="{Binding Id}" Click="UpdateDeviceAddress" IsEnabled="{Binding Paired}" Margin="0,0,10,0"/><Button Content="忘记设备" Tag="{Binding Id}" Click="ForgetDevice" IsEnabled="{Binding Paired}"/></WrapPanel>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="若列表为空，请在另一台电脑打开新版 LinkDesk，并把两端分别设为共享和接收。请先停止共享，再切换或忘记设备。" Foreground="#8A8E9C" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <Border Background="#FCFCFA" CornerRadius="20" Padding="24" Margin="0,22,0,0"><Expander Header="手动添加设备（发现不可用时）"><StackPanel Margin="0,18,0,0" IsEnabled="{Binding CanEdit}">
     <TextBlock Text="对方本机名称" Foreground="#7C8090"/><TextBox Text="{Binding ManualName,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
     <TextBlock Text="对方地址" Foreground="#7C8090"/><TextBox Text="{Binding ManualHost,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
     <TextBlock Text="对方完整 SHA-256 本机指纹" Foreground="#7C8090"/><TextBox Text="{Binding ManualFingerprint,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" FontFamily="Consolas" TextWrapping="Wrap"/>
     <TextBlock Text="对方系统" Foreground="#7C8090"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ManualPlatform}" Padding="10,7" Margin="0,6,0,16"><ComboBoxItem Tag="unknown" Content="未知"/><ComboBoxItem Tag="macOS" Content="macOS"/><ComboBoxItem Tag="Windows" Content="Windows"/></ComboBox>
     <TextBlock Text="以上信息均从另一端的连接页获取；另一端用途须与本机相反。完整指纹一致后才配对。" Foreground="#8A8E9C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <Button Content="添加并核对指纹" Click="AddManualDevice" HorizontalAlignment="Left" Background="#4C52D4" Foreground="White"/>
    </StackPanel></Expander></Border>
   </StackPanel>
   <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
    <Border Background="White" CornerRadius="20" Padding="24"><StackPanel><TextBlock Text="启动与后台" FontWeight="Bold" Margin="0,0,0,22"/>
     <Grid Margin="0,0,0,22"><StackPanel Margin="0,0,65,0"><TextBlock Text="登录后自启动" FontWeight="SemiBold"/><TextBlock Text="登录 Windows 后仅打开应用，不会强制开启共享。" Foreground="#8A8E9C" FontSize="12" Margin="0,6,0,0"/></StackPanel><CheckBox IsChecked="{Binding LoginEnabled}" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="登录后自启动"/></Grid>
     <Grid Margin="0,0,0,22"><StackPanel Margin="0,0,65,0"><TextBlock Text="启动后自动开始共享" FontWeight="SemiBold"/><TextBlock Text="默认关闭。开启后记住共享状态，等待本机屏幕稳定再连接；停止后保持停止。" TextWrapping="Wrap" Foreground="#8A8E9C" FontSize="12" Margin="0,6,0,0"/></StackPanel><CheckBox IsChecked="{Binding AutoStartOnLaunch}" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="启动后自动开始共享"/></Grid>
     <Grid Margin="0,0,0,22"><StackPanel Margin="0,0,65,0"><TextBlock Text="网络和唤醒恢复" FontWeight="SemiBold"/><TextBlock Text="已启动共享后检查网络恢复；保留健康进程，手动停止保持停止。" Foreground="#8A8E9C" FontSize="12" Margin="0,6,0,0"/></StackPanel><CheckBox IsChecked="{Binding AutoConnect}" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="网络和唤醒恢复"/></Grid>
     <Grid><StackPanel Margin="0,0,65,0"><TextBlock Text="关闭窗口后留在后台" FontWeight="SemiBold"/><TextBlock Text="继续共享，通过系统托盘重新打开。" Foreground="#8A8E9C" FontSize="12" Margin="0,6,0,0"/></StackPanel><CheckBox IsChecked="{Binding KeepBackground}" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="关闭窗口后留在后台"/></Grid>
    </StackPanel></Border>
    <Border Background="White" CornerRadius="20" Padding="24" Margin="0,22,0,0"><StackPanel><TextBlock Text="显示保护" FontWeight="Bold" Margin="0,0,0,18"/><CheckBox Content="允许远程键鼠请求点亮屏幕" IsChecked="{Binding WakeDisplayOnRemoteInput}"/><TextBlock Text="默认关闭，不在连接或切换电脑时请求点亮屏幕。开启后仅由实际远程输入请求，每次熄屏最多一次。保存后自动应用。若遇到显示无信号，请保持关闭，并使用本机键鼠唤醒。" Foreground="#8A8E9C" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
    <Border Background="White" CornerRadius="20" Padding="24" Margin="0,22,0,0"><StackPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="电脑与网络" FontWeight="Bold" Margin="0,0,0,18"/><TextBlock Text="本机用途" Foreground="#7C8090"/><WrapPanel Margin="0,10,0,18"><RadioButton GroupName="RoleSettings" Content="共享本机键鼠" IsChecked="{Binding Server}" Margin="0,0,25,0"/><RadioButton GroupName="RoleSettings" Content="接收另一台电脑的键鼠" IsChecked="{Binding IsReceiver}"/></WrapPanel>
     <TextBlock Text="本机名称" Foreground="#7C8090"/><TextBox Text="{Binding LocalName,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
     <TextBlock Text="当前连接的设备" Foreground="#7C8090"/><TextBlock Text="{Binding CurrentPeerLabel}" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="{Binding CurrentPeerSummary}" TextWrapping="Wrap" FontSize="12" Foreground="#8A8E9C" Margin="0,0,0,18"/>
     <CheckBox Content="局域网发现与自动查找" IsChecked="{Binding AutoDiscover}" Margin="0,4,0,12"/><TextBlock Text="Mac 与 Windows 都能共享或接收键鼠；两端设置为不同用途后保存。自动发现只更新所选设备的地址；不依赖某一种热点。" TextWrapping="Wrap" FontSize="12" Foreground="#8A8E9C" Margin="0,0,0,16"/>
     <Button Content="保存电脑信息" Click="SaveSettings" HorizontalAlignment="Left"/>
    </StackPanel></Border>
    <TextBlock Text="已内置连接核心。首次配对请核对两端的本机指纹；已有配对自动迁移。无需后台服务。" TextWrapping="Wrap" FontSize="12" Foreground="#8A8E9C" Margin="0,18,0,0"/>
   </StackPanel>
<StackPanel x:Name="InputPage" Visibility="Collapsed">
<Border Background="White" CornerRadius="20" Padding="24"><StackPanel>
<TextBlock Text="控制另一台电脑时的按键映射" FontWeight="Bold"/>
<TextBlock Text="{Binding MappingHint}" TextWrapping="Wrap" Foreground="#7C8090" Margin="0,12,0,20"/>
<StackPanel IsEnabled="{Binding CanMap}"><WrapPanel Margin="0,0,0,20"><Button Content="跨系统常用习惯" Click="MacMapping" Margin="0,0,12,0"/><Button Content="保持原样" Click="OriginalMapping"/></WrapPanel>
<Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Windows / Command" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Padding="10,7" SelectedValuePath="Tag" SelectedValue="{Binding MapSuper,Mode=TwoWay}"><ComboBoxItem Tag="ctrl" Content="Ctrl / Control"/><ComboBoxItem Tag="super" Content="Windows / Command"/><ComboBoxItem Tag="alt" Content="Alt / Option"/><ComboBoxItem Tag="shift" Content="Shift"/><ComboBoxItem Tag="meta" Content="Meta"/><ComboBoxItem Tag="altgr" Content="AltGr"/><ComboBoxItem Tag="none" Content="不发送此修饰键"/></ComboBox></Grid>
<Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Ctrl / Control" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Padding="10,7" SelectedValuePath="Tag" SelectedValue="{Binding MapControl,Mode=TwoWay}"><ComboBoxItem Tag="ctrl" Content="Ctrl / Control"/><ComboBoxItem Tag="super" Content="Windows / Command"/><ComboBoxItem Tag="alt" Content="Alt / Option"/><ComboBoxItem Tag="shift" Content="Shift"/><ComboBoxItem Tag="meta" Content="Meta"/><ComboBoxItem Tag="altgr" Content="AltGr"/><ComboBoxItem Tag="none" Content="不发送此修饰键"/></ComboBox></Grid>
<Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Alt / Option" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Padding="10,7" SelectedValuePath="Tag" SelectedValue="{Binding MapOption,Mode=TwoWay}"><ComboBoxItem Tag="ctrl" Content="Ctrl / Control"/><ComboBoxItem Tag="super" Content="Windows / Command"/><ComboBoxItem Tag="alt" Content="Alt / Option"/><ComboBoxItem Tag="shift" Content="Shift"/><ComboBoxItem Tag="meta" Content="Meta"/><ComboBoxItem Tag="altgr" Content="AltGr"/><ComboBoxItem Tag="none" Content="不发送此修饰键"/></ComboBox></Grid>
<Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Shift" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Padding="10,7" SelectedValuePath="Tag" SelectedValue="{Binding MapShift,Mode=TwoWay}"><ComboBoxItem Tag="ctrl" Content="Ctrl / Control"/><ComboBoxItem Tag="super" Content="Windows / Command"/><ComboBoxItem Tag="alt" Content="Alt / Option"/><ComboBoxItem Tag="shift" Content="Shift"/><ComboBoxItem Tag="meta" Content="Meta"/><ComboBoxItem Tag="altgr" Content="AltGr"/><ComboBoxItem Tag="none" Content="不发送此修饰键"/></ComboBox></Grid>
</StackPanel></StackPanel></Border>
<Border Background="White" CornerRadius="20" Padding="24" Margin="0,22,0,0"><StackPanel>
<TextBlock Text="接收键鼠时的滚动" FontWeight="Bold"/>
<TextBlock Text="{Binding ScrollingHint}" TextWrapping="Wrap" Foreground="#7C8090" Margin="0,12,0,22"/>
<StackPanel IsEnabled="{Binding CanScroll}"><Grid Margin="0,0,0,22"><StackPanel Margin="0,0,65,0"><TextBlock Text="反转纵向滚动" FontWeight="SemiBold"/><TextBlock Text="远程滚轮上下方向相反时开启。" Foreground="#8A8E9C" FontSize="12" Margin="0,6,0,0"/></StackPanel><CheckBox IsChecked="{Binding InvertVertical}" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="反转纵向滚动"/></Grid>
<Grid Margin="0,0,0,22"><StackPanel Margin="0,0,65,0"><TextBlock Text="反转横向滚动" FontWeight="SemiBold"/><TextBlock Text="单独调整左右滚动方向。" Foreground="#8A8E9C" FontSize="12" Margin="0,6,0,0"/></StackPanel><CheckBox IsChecked="{Binding InvertHorizontal}" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="反转横向滚动"/></Grid>
<Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="纵向滚动速度" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0.1" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding VerticalSpeed}" AutomationProperties.Name="纵向滚动速度"/><TextBlock Grid.Column="2" Text="{Binding VerticalSpeed,StringFormat={}{0:F1}×}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
<Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="横向滚动速度" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0.1" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding HorizontalSpeed}" AutomationProperties.Name="横向滚动速度"/><TextBlock Grid.Column="2" Text="{Binding HorizontalSpeed,StringFormat={}{0:F1}×}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
<Button Content="恢复滚动默认值" Click="ResetScrolling" HorizontalAlignment="Left"/></StackPanel>
</StackPanel></Border>
<Grid Margin="0,22,0,0"><TextBlock Text="保存后自动应用：共享运行中会重新加载连接。" Foreground="#8A8E9C" FontSize="12" VerticalAlignment="Center" Margin="0,0,160,0" TextWrapping="Wrap"/><Button Content="保存键鼠设置" Click="SaveInput" HorizontalAlignment="Right" Background="#4C52D4" Foreground="White"/></Grid>
</StackPanel>
   <StackPanel x:Name="LogsPage" Visibility="Collapsed"><Border Background="White" CornerRadius="20" Padding="24"><StackPanel><DockPanel><Button Content="复制日志" Click="CopyLogs" DockPanel.Dock="Right"/><TextBlock Text="最近 300 条记录" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11" Height="430" BorderThickness="0" Margin="0,18,0,0" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></StackPanel></Border></StackPanel>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
