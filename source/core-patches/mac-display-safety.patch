+  const auto result = IOPMAssertionDeclareUserActivity(CFSTR("LinkDesk actual remote input"), kIOPMUserActiveLocal, &computer->m_userActivityAssertionID);
+  LOG_INFO("LinkDesk explicit display wake: remote %s; once per observed off cycle; result=%d", reason, result);
+}
 
