--- /dev/null
+++ b/src/lib/platform/DisplayWakePolicy.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+ * LinkDesk Windows display-safety patch, 2026.
+ */
+#pragma once
+#include <cstdint>
+
+// An unknown display state is not an off state. Duplicate off notifications
+// must not re-arm a request; only a new on/dim -> off cycle can do so.
+class DisplayWakePolicy {
+public:
+  void displayState(std::uint32_t state) {
+    const bool off = state == 0;
+    if (off != m_off) m_requested = false;
+    m_off = off;
+  }
+  bool requestFromInput(bool enabled, bool primary) {
+    if (!enabled || primary || !m_off || m_requested) return false;
+    m_requested = true;
+    return true;
+  }
+private:
+  bool m_off = false;
+  bool m_requested = false;
+};
